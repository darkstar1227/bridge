.DS_Store

# Per-user state, never shared repo state. Covers bridge-mind's cognitive logs
# (decisions.jsonl, focus-state.json, focus-log.jsonl, inbox.md) and any
# bridge-dev/bridge-fin config that may hold a plaintext token.
.bridge/

# skill-creator eval run artifacts (transcripts, eval_metadata.json). These land
# under plugins/*/skills/ where both Claude Code and Codex scan for skills, and
# Codex's `skills: "./skills/"` would otherwise package them on install.
plugins/*/skills/*-workspace/

# Python build/test artifacts from skills that shell out to `uv run`. A stray
# `skills/` tree at the repo root (9.9M of .venv and caches) came from running
# one of those scripts with the wrong cwd.
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Claude Code project settings. Deliberately ignored in full: this is a
# marketplace repo, so committing an `enabledPlugins` block would auto-enable
# plugins for everyone who clones it — including ones they have not installed.
# Which plugins to enable is the installer's decision, not this repo's.
.claude/
