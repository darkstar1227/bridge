{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/risk-brake-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for irreversible actions..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/focus-timer.sh\"",
            "timeout": 5,
            "statusMessage": "Checking session elapsed time..."
          }
        ]
      }
    ]
  }
}
